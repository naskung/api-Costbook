# copy ไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (.env ห้าม commit)
# ค่าในไฟล์นี้ห้ามมีเครื่องหมาย # หรือ $

PORT=8080
ALLOWED_ORIGIN=*
DATABASE_URL=postgres://manas@localhost:5432/costbook?sslmode=disable

# ข้อความลับไว้เซ็น token สร้างด้วยคำสั่ง: openssl rand -hex 32
JWT_SECRET=change-me
