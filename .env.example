# copy ไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (.env ห้าม commit)
# ค่าในไฟล์นี้ห้ามมีเครื่องหมาย # หรือ $

PORT=8080
ALLOWED_ORIGIN=*
DATABASE_URL=postgres://manas@localhost:5432/costbook?sslmode=disable

# ข้อความลับไว้เซ็น token สร้างด้วยคำสั่ง: openssl rand -hex 32
JWT_SECRET=change-me

# AI (ไม่ใส่ก็ได้ทั้งหมด ส่วนอื่นใช้ได้ปกติ)
# ANTHROPIC_API_KEY = key ของ Claude (สมัครที่ https://platform.claude.com) — ร้านใส่เองที่หน้าตั้งค่าแทนได้
ANTHROPIC_API_KEY=
# GEMINI_API_KEY = AI ฟรีตอนร้านไม่มี key Claude (สมัครฟรีที่ https://aistudio.google.com/apikey) — แชทได้ / เช็คราคาตลาดต้องค้น Google ดู GEMINI_WEB_SEARCH
GEMINI_API_KEY=
# GEMINI_MODEL = รุ่นของ Gemini (ไม่ใส่ = gemini-3.8-flash)
GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS = รุ่นสำรองเมื่อรุ่นหลักยุ่ง / โควตาเต็ม คั่นด้วย , (ไม่ใส่ = gemini-3.5-flash,gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=
# GEMINI_WEB_SEARCH = on → Gemini ค้น Google ตอนเช็คราคาตลาดได้ — ต้องเปิดใช้ Gemini แบบเสียเงิน (billing) ก่อน
#   แบบฟรีค้น Google ไม่ได้ (โควตา 0) / แบบเสียเงิน: ค้นฟรี 5,000 ครั้ง/เดือน + ค่า AI ประมาณไม่ถึง 1 บาทต่อการเช็ค 1 ครั้ง
GEMINI_WEB_SEARCH=
# GEMINI_SEARCH_MODEL = รุ่นที่ใช้ค้น Google (ไม่ใส่ = รุ่นเดียวกับ GEMINI_MODEL)
GEMINI_SEARCH_MODEL=
# TAVILY_API_KEY = ตัวค้นเว็บฟรี (สมัครที่ https://tavily.com ฟรี 1,000 ครั้ง/เดือน ไม่ต้องผูกบัตร)
#   ใส่แล้ว Gemini ฟรีเช็คราคาตลาดได้ (เช็ค 1 สินค้า ≈ ค้น 3–4 ครั้ง)
TAVILY_API_KEY=
